{
  "expo": {
    "name": "newari",
    "slug": "newari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "newari",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.andreasstudios.newari",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app requires access to the microphone to function properly."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#BB4624",
        "foregroundImage": "./assets/images/android-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.andreasstudios.newari",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#BB4624"
        }
      ],
      "expo-sqlite",
       "expo-secure-store",
      "expo-video",
        [
        "expo-av",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for pronunciation practice"
        }
      ]
    
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5c455683-d416-4cf6-85a1-c90b416fd7f0"
      }
    },
    "owner": "sthshres"
  }
}
